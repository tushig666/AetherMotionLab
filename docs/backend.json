{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user account details and subscription plan information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "plan"]
    },
    "Generation": {
      "title": "Elite Generation",
      "description": "Stores generated SVG, CSS, and GSAP animation data.",
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "svg": { "type": "string" },
        "css": { "type": "string" },
        "gsap": { "type": "string" },
        "colorPalette": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "github.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile document."
    },
    "/users/{userId}/generations/{genId}": {
      "schema": "#/entities/Generation",
      "description": "User's personal generation history."
    }
  }
}